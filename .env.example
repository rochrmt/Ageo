# ============================================================
#  Configuration AGEO — Copier ce fichier en .env et remplir
#  Usage : cp .env.example .env && nano .env
# ============================================================

# ── Domaine ──────────────────────────────────────────────────
# Le sous-domaine de l'application (doit pointer vers le VPS via DNS)
DOMAIN=exemple.mbila.pro

# ── Préfixe des conteneurs ───────────────────────────────────
# Unique par entreprise (ex: ageo, entreprise2, entreprise3)
CONTAINER_PREFIX=ageo

# ── Base de données ──────────────────────────────────────────
DB_NAME=ageo
DB_ROOT_PASSWORD=ChangerCeMotDePasse123!

# ── Sécurité ─────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
JWT_SECRET=generer_avec_openssl_rand_hex_32

# ── Licence ──────────────────────────────────────────────────
LICENCE_SECRET=generer_avec_openssl_rand_hex_32
LICENCE_KEY=
