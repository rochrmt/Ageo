# ============================================================
#  Configuration Traefik — Copier ce fichier en .env et remplir
#  Emplacement : /opt/traefik/.env
#  Usage : cp .env.example .env && nano .env
# ============================================================

# ── Email pour Let's Encrypt ─────────────────────────────────
# Recevra les notifications d'expiration de certificats SSL
ACME_EMAIL=votre@email.com

# ── Domaine du dashboard Traefik ─────────────────────────────
TRAEFIK_DOMAIN=traefik.votre-domaine.com
